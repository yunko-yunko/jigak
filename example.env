# 이 파일을 .env로 복사한 뒤 실제 값으로 설정합니다. .env는 커밋하지 않습니다.
# 비밀 값은 서버 전용입니다. EXPO_PUBLIC_ 변수나 프런트엔드 번들에 넣지 않습니다.

# 로컬은 development, Cloud Run은 production으로 설정합니다.
NODE_ENV=development
# Cloud Run 컨테이너는 0.0.0.0에서 수신해야 합니다.
HOST=0.0.0.0
# Cloud Run은 --port 8080에 따라 PORT를 자동 주입합니다. 배포 env 파일에는 넣지 않습니다.
PORT=8080
# 쉼표로 구분한 정확한 웹 출처 목록입니다. 쿠키 인증 사용 시 *를 쓰지 않습니다.
# 마지막 /나 경로를 붙이지 않습니다. 네이티브 앱 전용이면 빈 값으로 명시합니다.
# CORS_ORIGINS 자체를 생략하면 아래 localhost 기본값이 적용되어 production 검증에서 거부됩니다.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# 요청 IP 판정에 신뢰할 앞단 프록시 수입니다(0~5). 기본 0은 전달 헤더를 신뢰하지 않습니다.
# Cloud Run에서는 실제 ingress 경로를 확인한 후 설정합니다. 잘못 늘리면 IP 제한을 우회할 수 있습니다.
TRUST_PROXY_HOPS=0

# TypeORM DataSource의 PostgreSQL 접속 정보입니다. 아래 비밀번호는 compose.yaml 로컬 개발 전용입니다.
# Cloud Run DB_HOST=/cloudsql/프로젝트ID:리전:인스턴스ID 로 설정합니다.
# 서버 시작 시 TypeORM 마이그레이션을 자동 적용합니다. DB 사용자는 테이블 생성/변경 권한이 필요합니다.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=jigakmap
DB_USER=jigakmap
# 운영에서는 Cloud Run 환경변수 또는 Secret Manager로 공급합니다.
DB_PASSWORD=local-development-only
# Cloud SQL Unix socket은 Auth Proxy가 암호화합니다. 그 경우 false를 유지합니다.
# 직접 TCP/TLS 연결은 CA 구성과 함께 별도 검토 후 true로 설정합니다.
DB_SSL=false
# 인스턴스당 풀 상한입니다. 최대 서비스 인스턴스 수와 곱해 DB 연결 예산을 정합니다.
DB_POOL_MAX=5

# 카카오 지도/장소 검색 REST 키입니다. 카카오 로그인 키와 용도가 다릅니다.
KAKAO_REST_API_KEY=
# 기본 카카오 REST 키가 한도에 걸리거나 거부되면 쓰는 예비 키입니다. 비워 두면 쓰지 않습니다.
# API마다 따로 바꿔 쓰고(한도는 키별·API별로 매일 0시 KST에 초기화), 로그인 키(KAKAO_LOGIN_REST_API_KEY)와는 별개입니다.
KAKAO_REST_API_KEY_FALLBACK=
# 보행 라우팅 사용 여부입니다. 비활성화하면 연결 보행 경로를 추정하지 않습니다.
PEDESTRIAN_ROUTING_ENABLED=true
# 운영에서는 자체 OSRM foot endpoint를 권장합니다. 끝 경로: /route/v1/foot
# 빈 값은 기존 FOSSGIS 공개 서버를 사용하며 프로세스별 요청 간격 제한이 적용됩니다.
PEDESTRIAN_OSRM_URL=
# 운영 보행 API에 전달할 서비스명/연락처 등 User-Agent입니다.
PEDESTRIAN_USER_AGENT=
# 따릉이 대여소 사이 자전거 경로 사용 여부와 자체 OSRM bike endpoint(끝 경로: /route/v1/bike)입니다.
# 빈 값은 FOSSGIS 공개 서버를 쓰고 프로세스별 요청 간격 제한이 적용됩니다.
BICYCLE_ROUTING_ENABLED=true
BICYCLE_OSRM_URL=
# 중간 환승 허브 추가 검색 수(0~2)와 요청당 외부 호출 예산(1~96)입니다.
# 72는 대중교통 후보마다 처음·마지막 도보를 모두 확인하는 전체 검색입니다.
ROUTE_INTERMEDIATE_HUBS=2
ROUTE_CALL_LIMIT=72
# true이면 검색 단계 시간/실패/호출 수를 기록합니다. 위치와 키는 기록하지 않습니다.
ROUTE_METRICS_ENABLED=false

# 서울 지하철 실시간 도착 전용 열린데이터 인증키입니다.
SEOUL_OPEN_API_KEY=
# 위 키의 일일 트래픽이 소진되면(ERROR-337) 0시 KST까지 쓰는 예비 키입니다. 비워 두면 쓰지 않습니다.
SEOUL_OPEN_API_KEY_FALLBACK=
# 공공데이터포털 통합 서비스 키입니다. 일반 키와 인코딩 키를 모두 지원합니다.
# TAGO 정류소/도착/공유 PM, 서울 정류소, 기상청 서비스별 활용승인이 필요합니다.
DATA_GO_KR_SERVICE_KEY=
# 다른 공공데이터포털 계정의 예비 키입니다. 서울 버스 정류소·도착(15000303)과 TAGO 버스는 오퍼레이션마다
# 일일 한도가 따로 있고, 기본 키가 그 오퍼레이션 한도를 다 쓰면 0시 KST까지 이 키로 넘깁니다. 비워 두면 쓰지 않습니다.
DATA_GO_KR_SERVICE_KEY_FALLBACK=
# 버스 오퍼레이션·키별 하루 호출 상한입니다(빈 값 1000 = 개발계정 한도, 0 = 제한 없음). 운영계정으로 늘면 맞춰 올립니다.
# 80%에서 주변 교통, 95%에서 경로 검색이 실시간 버스 도착 대신 배차 기준 대기를 쓰고, 나머지는 길안내에 남깁니다.
DATA_GO_KR_DAILY_LIMIT=
# 따릉이 실시간 재고 조회용 서울 열린데이터 일반 인증키입니다.
SEOUL_BIKE_API_KEY=
# 서울 실시간 도시데이터 도로 소통/사고/공사 조회용 일반 인증키입니다.
SEOUL_CITY_DATA_API_KEY=
# 공영 시간제 주차장 정보/재고 키입니다. 빈 값은 도시→자전거→지하철 키를 사용합니다.
SEOUL_PARKING_API_KEY=
# T-DATA 신호 잔여시간 키입니다. 교차로 위치는 서울 도시데이터 키로 조회합니다.
# 둘 다 있어야 첫 도보의 횡단보도 대기를 반영합니다.
TRAFFIC_SIGNAL_API_KEY=
# 이동 시간 비교(POST /api/travel-times)의 GPT 키와 모델입니다. 좌표는 보내지 않습니다.
# 빈 키는 거리와 기본 속도로 계산합니다.
OPENAI_API_KEY=
OPENAI_MODEL=
# 선택적인 운영사 GBFS 피드 JSON 배열(최대 20개)입니다. 빈 값은 추가 피드 없음입니다.
# 예: [{"provider":"운영사","vehicleStatusUrl":"https://gbfs.example.com/vehicle_status.json","kind":"bicycle"}]
# 선택 필드: vehicleTypesUrl, kind(bicycle/e-bicycle/kick-scooter/motor-scooter).
# 공식 공개 HTTPS 주소를 사용합니다. localhost/내부 주소/IP/URL 자격 증명은 허용하지 않습니다.
MOBILITY_GBFS_FEEDS=
# 시연용 가상 킥보드·공유 전기자전거 시뮬레이터입니다. 실제 운영사·기기·대여가 아닌 시연용 가상 데이터입니다.
# scooter, ebike(또는 e-bike)를 쉼표로 적습니다. scooter만 쓰면 지금까지처럼 킥보드만, scooter,ebike면 둘 다 켜집니다.
# 빈 값이나 다른 값은 꺼짐이며, 모르는 이름은 시작할 때 경고 로그로 알립니다. 켜면 지도에 가상 차량이 표시되고 킥보드·전기자전거 경로가
# '시연용 가상 킥보드'·'시연용 가상 전기자전거'로 표시되어 검색에 포함되며, /api/sim/* 조회가 열립니다.
# 따릉이 실제 데이터(SEOUL_BIKE_API_KEY)는 그대로이며 이 설정과 무관합니다.
MOBILITY_SIMULATION=
# 가상 킥보드 대수(3000~72000, 빈 값이면 서울 등록 대수 14933)와 시드(기본 jigak)입니다.
# 같은 값이면 모든 인스턴스가 같은 상태를 계산합니다.
MOBILITY_SIMULATION_FLEET=
# 가상 전기자전거 대수(1000~60000, 빈 값이면 서울 등록 대수 52605)입니다. 두 차종 합계는 3000~72000대입니다.
# 켜면 서버 메모리가 크게 늘어 Cloud Run은 --cpu 2, --memory 2Gi로 배포합니다(docs/DEPLOYMENT.md).
MOBILITY_SIMULATION_EBIKE_FLEET=
MOBILITY_SIMULATION_SEED=
# 계산한 하루치 창을 저장할 디렉터리입니다. 저장해 두면 재시작·새 인스턴스가 다시 계산하지 않고 약 0.1초에 읽습니다.
# 빈 값이면 저장하지 않습니다. 상대 경로는 실행 위치 기준이며, Cloud Run은 서울 리전 Cloud Storage 볼륨 /sim-windows를 씁니다.
MOBILITY_SIMULATION_WINDOW_DIR=.cache/sim-windows
# true(기본)면 오늘 창이 준비될 때까지 /api/health/ready가 503으로 답합니다. false면 DB만 확인합니다.
MOBILITY_SIMULATION_READY_GATE=
# 유동인구 가중치(§22) 파일을 바꿀 때만 씁니다. 빈 값이면 저장소의 OSM 기반 파일(shared-mobility-foot-weights-osm-v1.json)입니다.
# NGII 기반 파일은 국외 반출 금지라 git에 없습니다(mvp/data/derived/ngii/shared-mobility-foot-weights-ngii-v1.json). 쓰려면 절대 경로를 넣습니다.
# 경로가 틀리거나 파일이 깨졌으면 서버가 시작하지 않습니다. 어느 파일을 읽었는지가 모델 버전에 들어가 저장된 창이 섞이지 않습니다.
MOBILITY_FOOT_WEIGHTS_PATH=

# 외부에서 접근하는 API 기준 주소입니다. 운영에서는 실제 공개 HTTPS 주소를 사용합니다.
AUTH_PUBLIC_BASE_URL=http://localhost:8080
# 로그인 성공 후 돌아갈 웹 앱의 고정 URL입니다. query/fragment/userinfo는 넣지 않습니다.
AUTH_WEB_RETURN_URL=http://localhost:8081/
# OAuth 토큰 암호화에 쓰는 정확히 32바이트 난수의 Base64 값입니다.
# 운영 필수 비밀입니다. 기존 DB가 있다면 임의 교체하지 않습니다. Cloud Run 환경변수 또는 Secret Manager로 공급합니다.
# 생성: node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('base64'))"
AUTH_TOKEN_ENCRYPTION_KEY=
# Google 웹 OAuth 클라이언트 ID/Secret입니다. 두 값이 있어야 로그인 제공사가 활성화됩니다.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 카카오 로그인용 REST 키/Secret입니다. 지도 검색 키만으로는 로그인을 활성화하지 않습니다.
KAKAO_LOGIN_REST_API_KEY=
KAKAO_LOGIN_CLIENT_SECRET=
# 해당 카카오 앱에서 OpenID Connect를 실제 활성화했을 때만 true로 설정합니다.
KAKAO_LOGIN_OIDC=false
# Apple Services ID, Team ID, Key ID, .p8 ES256 개인 키입니다. 모두 있어야 활성화됩니다.
APPLE_SERVICE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PEM 줄바꿈은 \n으로 표현할 수 있습니다. 운영에서는 Secret Manager에서 원문을 공급합니다.
APPLE_PRIVATE_KEY=

# 선택: NGII 1:1,000 지도 파일(seoul-ngii-v1.pmtiles)의 절대 경로입니다. 설정하면 GET /api/maps/seoul-ngii-v1.pmtiles가
# 이 파일을 Range 요청으로만 내려줍니다(한 번에 한 구간, 512 KiB까지). 빈 값이면 그 주소는 404입니다. 파일이 없어도 서버는 시작합니다.
# 국외 반출 금지 자료라 git, 공개 버킷, 다른 리전, CDN에 두지 않습니다. 로컬에서는 mvp/data/map/seoul-ngii-v1.pmtiles의 절대 경로를 넣습니다.
# 앱은 EXPO_PUBLIC_MAP_NGII_TILES_URL=http://localhost:8080/api/maps/seoul-ngii-v1.pmtiles 처럼 이 서버 주소로 읽습니다.
MAP_NGII_PMTILES_PATH=

# 선택: 모델 갱신 Job이 쓰는 manifest.json 경로입니다(Cloud Run은 버킷을 읽기 전용으로 붙인 /models/manifest.json).
# 설정하면 아래 ETA_*_PATH 대신 manifest가 가리키는 모델을 쓰고, 새 모델은 재시작 없이 바뀝니다. 빈 값은 아래 고정 경로 방식 그대로입니다.
# 새 파일은 sha256과 파싱을 통과해야 바뀌고, 실패하면 이전 모델을 유지합니다(docs/MODEL-REFRESH.md).
MODEL_MANIFEST_PATH=
# manifest를 다시 확인하는 주기(초, 1~3600). 기본 60.
MODEL_MANIFEST_POLL_SECONDS=
# 갱신 Job의 실행 보고서 경로. 빈 값은 manifest와 같은 폴더의 refresh-status.json입니다.
MODEL_REFRESH_STATUS_PATH=
# 갱신 Job의 Cloud Scheduler 시각(KST, 쉼표로 구분). health의 nextScheduledAt 계산에만 쓰입니다. 기본 05:30,09:30,13:30.
MODEL_REFRESH_SCHEDULE_KST=

# 선택: 검증된 기존 eta-residual-v1 모델의 읽기 전용 JSON 파일 경로입니다.
# 빈 값이면 학습 기반 residual 보정을 적용하지 않습니다. Cloud Run 쓰기 경로로 쓰지 않습니다.
ETA_MODEL_PATH=
# 선택: 검증된 공개 버스 모델 JSON의 읽기 전용 경로입니다. 빈 값은 비활성화입니다.
# public-bus-duration-v2/v3를 읽고, 학습 후 7일이 지나면 쓰지 않습니다.
ETA_PUBLIC_BUS_MODEL_PATH=
# 선택: 공간 버스 모델(seoul-bus-spatial-v3) JSON의 읽기 전용 경로입니다. 빈 값은 비활성화입니다.
# 정류장 수와 승하차 위치로 버스 구간 상한을 정하고, 못 쓰는 구간은 위 공개 버스 모델이 맡습니다. 학습 후 7일이 지나면 쓰지 않습니다.
ETA_SPATIAL_BUS_MODEL_PATH=
# 선택: 지하철 개찰 모델(seoul-rail-gate-v1) JSON의 읽기 전용 경로입니다. 빈 값은 비활성화입니다.
# 승차 개찰부터 하차 개찰까지의 상한으로 지하철 구간의 늦은 범위만 넓히고 예상 시간은 바꾸지 않습니다. 학습 후 7일이 지나면 쓰지 않습니다.
ETA_RAIL_GATE_MODEL_PATH=
# 선택: 따릉이 대여소 쌍별 실측 이동시간 JSON(ddareungi-dock-pair-v1)의 읽기 전용 경로입니다.
# 빈 값은 경로 공급원의 자전거 시간을 그대로 씁니다.
BICYCLE_RIDE_TIMES_PATH=
# 선택: 따릉이 공간 모델(seoul-bicycle-spatial-v2) JSON의 읽기 전용 경로입니다. 빈 값은 비활성화입니다.
# 위 실측표에 없는 대여소 쌍의 주행 시간을 2026년 6월 직진 주행 기록으로 추정합니다(없으면 OSRM 자전거 시간).
# 공휴일 달력 검토 기한(2026-11-15)까지만 쓰며, 달력을 다시 검토한 뒤 다시 만들어야 합니다.
ETA_SPATIAL_BICYCLE_MODEL_PATH=
# 선택: 오프라인으로 학습한 구간 보정 HGB 모델(eta-hgb-v1)의 읽기 전용 경로입니다.
# 이동 기록이 삭제되면 이 프로세스에서 즉시 끄고, 다시 학습해야 합니다.
ETA_HGB_MODEL_PATH=
# 선택: 공개 자전거 shadow 연구 모델 model/report/protocol.json 폴더입니다.
# 경로 시간을 대체하지 않습니다. 빈 값은 비활성화이며 파일은 읽기 전용으로 제공합니다.
ETA_PUBLIC_BICYCLE_SHADOW_DIRECTORY=
# 계정, 관측값, contextual/journey ETA 모델은 PostgreSQL에 영속화합니다.
# 과거 AUTH_DATABASE_PATH / ETA_OBSERVATION_DATABASE_PATH / ETA_CONTEXT_MODEL_PATH /
# ETA_JOURNEY_MODEL_PATH 는 이 서버에서 사용하지 않습니다.
